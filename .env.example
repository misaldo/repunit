# Copy this file to .env and fill in your own values.
# Never commit .env or share secret keys.
SUPABASE_PROJECT_ID="kqezgcwfqfntazucbbzt"
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_URL="https://kqezgcwfqfntazucbbzt.supabase.co"
VITE_SUPABASE_PROJECT_ID="kqezgcwfqfntazucbbzt"
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
VITE_SUPABASE_URL="https://kqezgcwfqfntazucbbzt.supabase.co"

# Stripe billing secrets (configure these as Supabase Edge Function secrets).
# Never expose STRIPE_SECRET_KEY or STRIPE_WEBHOOK_SECRET with a VITE_ prefix.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_MONTHLY=price_replace_me
STRIPE_PRICE_YEARLY=price_replace_me
APP_URL=http://localhost:8080

# Supabase Edge Functions also receive SUPABASE_URL, SUPABASE_ANON_KEY
# and SUPABASE_SERVICE_ROLE_KEY from the Supabase project environment.


# Web Push: the public key is exposed to the browser; keep private key and webhook secret server-only.
VITE_VAPID_PUBLIC_KEY=replace_with_vapid_public_key
VAPID_PUBLIC_KEY=replace_with_vapid_public_key
VAPID_PRIVATE_KEY=replace_with_vapid_private_key
VAPID_SUBJECT=mailto:admin@your-domain.example
PUSH_WEBHOOK_SECRET=replace_with_long_random_secret
